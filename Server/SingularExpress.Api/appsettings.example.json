{
  "//": "Copy this file to appsettings.Development.json. Never put real secrets in it: use dotnet user-secrets (see SECURITY.md).",

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost;Initial Catalog=SingularExpress;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "Jwt": {
    "Secret": "",
    "Issuer": "SingularExpress",
    "Audience": "SingularExpressUsers",
    "ExpiryMinutes": 60
  },

  "AuthSecurity": {
    "AllowedEmailDomain": "@singular.co.za",
    "MaxFailedLoginAttempts": 3,
    "LockoutSeconds": 60,
    "ResetPinExpiryMinutes": 3,
    "MaxResetPinAttempts": 5,
    "PasswordHistoryCount": 5,
    "AuthRequestsPerMinute": 10
  },

  "FinancialPeriod": {
    "InitialPeriod": "2026-10",
    "TimeZoneId": "Africa/Johannesburg",
    "AllowRolloverBeforePeriodEnd": true
  },

  "Email": {
    "Provider": "File",
    "FileOutputFolder": "App_Data/dev-emails",
    "FromEmail": "noreply@singular.co.za",
    "FromName": "SingularExpress",
    "SendGridApiKey": ""
  },

  "Seed": {
    "SuperUserEmail": "mmabena@singular.co.za",
    "SuperUserPassword": "Mabena81#"
  }
}
